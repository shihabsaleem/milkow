rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function: check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Default: denny everything for safety
    match /{document=**} {
      allow read, write: if false;
    }

    // Settings: Only Admins can read/write
    match /settings/{docId} {
      allow read, write: if isSignedIn(); // Simplified: anyone signed in can read settings for now
    }

    // Customers: Admins can manage all, users can only see their own (if we add individual logins later)
    match /customers/{userId} {
      allow read, write: if isSignedIn();
    }

    // Inventory, Products, Pipeline: Read for all signed-in, Write for Admins
    match /inventory/{item} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); 
    }
    match /products/{item} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /pipeline/{item} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Bills
    match /bills/{billId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
